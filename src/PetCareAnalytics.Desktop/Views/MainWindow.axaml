<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PetCareAnalytics.Desktop.ViewModels"
        xmlns:models="using:PetCareAnalytics.Core.Models"
        x:Class="PetCareAnalytics.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PetCareAnalytics"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

	<Window.Styles>
		<Style Selector="ToggleButton.nav-button">
			<Setter Property="HorizontalContentAlignment"
					Value="Left"/>
			<Setter Property="Padding"
					Value="12"/>
			<Setter Property="Background"
					Value="#172B4D"/>
			<Setter Property="Foreground"
					Value="#D5DFED"/>
			<Setter Property="BorderThickness"
					Value="0"/>
		</Style>

		<Style Selector="ToggleButton.nav-button:checked">
			<Setter Property="Background"
					Value="#29466F"/>
			<Setter Property="Foreground"
					Value="White"/>
		</Style>

		<Style Selector="ToggleButton.nav-button:pointerover">
			<Setter Property="Background"
					Value="#29466F"/>
		</Style>
	</Window.Styles>
	<Grid ColumnDefinitions="245,*"
          Background="#F4F6FA">

		<!-- Бічна панель -->
		<Border Grid.Column="0"
                Background="#172B4D"
                Padding="22">

			<StackPanel Spacing="24">

				<StackPanel Spacing="5">
					<TextBlock Text="PetCareAnalytics"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="White"/>

					<TextBlock Text="Моніторинг домашніх тварин"
                               FontSize="12"
                               Foreground="#B8C7DD"/>
				</StackPanel>

				<Border Height="1"
                        Background="#3B506F"/>

				<StackPanel Spacing="14">
					<TextBlock Text="НАВІГАЦІЯ"
							   FontSize="11"
							   FontWeight="Bold"
							   Foreground="#91A4C1"/>

					<ToggleButton Classes="nav-button"
								  Content="⌂   Головна"
								  IsChecked="{Binding IsHomeSection, Mode=OneWay}"
								  Command="{Binding ShowHomeCommand}"/>

					<ToggleButton Classes="nav-button"
								  Content="♧   Мої тварини"
								  IsChecked="{Binding IsPetsSection, Mode=OneWay}"
								  Command="{Binding ShowPetsCommand}"/>

					<ToggleButton Classes="nav-button"
								  Content="▤   Вимірювання"
								  IsChecked="{Binding IsMeasurementsSection, Mode=OneWay}"
								  Command="{Binding ShowMeasurementsCommand}"/>

					<ToggleButton Classes="nav-button"
								  Content="▥   Аналітика"
								  IsChecked="{Binding IsAnalyticsSection, Mode=OneWay}"
								  Command="{Binding ShowAnalyticsCommand}"/>
				</StackPanel>

				<Border Height="1"
                        Background="#3B506F"/>

				<TextBlock Text="Система обліку та аналізу показників здоров'я і активності домашніх тварин."
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="#B8C7DD"/>

			</StackPanel>
		</Border>

		<!-- Основна частина -->
		<Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              Margin="28">

			<!-- Верхня панель -->
			<Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  Margin="0,0,0,24">

				<StackPanel Spacing="5">
					<TextBlock Text="{Binding PageTitle}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#172B4D"/>

					<TextBlock Text="{Binding PageSubtitle}"
                               FontSize="14"
                               Foreground="#718096"/>
				</StackPanel>

				<StackPanel Grid.Column="1"
							Orientation="Horizontal"
							Spacing="10"
							VerticalAlignment="Center">

					<Button Content="＋ Додати тварину"
							Command="{Binding ShowAddPetFormCommand}"
							Padding="16,10"
							Background="#2563EB"
							Foreground="White"/>

					<Button Content="＋ Вимірювання"
							Command="{Binding ShowAddMeasurementFormCommand}"
							Padding="16,10"
							Background="#0F9D78"
							Foreground="White"/>

					<Button Content="⟳ Оновити"
							Command="{Binding RefreshCommand}"
							Padding="18,10"/>

				</StackPanel>
			</Grid>

			<ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

				<StackPanel Spacing="20">
					<!-- Форма додавання тварини -->
					<Border Background="White"
							CornerRadius="12"
							Padding="20"
							IsVisible="{Binding IsAddPetFormVisible}">

						<StackPanel Spacing="14">

							<TextBlock Text="Додавання нової тварини"
									   FontSize="20"
									   FontWeight="Bold"
									   Foreground="#172B4D"/>

							<Grid ColumnDefinitions="2*,*,2*,*,*"
								  ColumnSpacing="12">

								<StackPanel Grid.Column="0"
											Spacing="6">
									<TextBlock Text="Ім'я *"
											   FontWeight="SemiBold"
											   FontSize="12"/>
									<TextBox Text="{Binding NewPetName}"
											 PlaceholderText="Наприклад, Рекс"/>
								</StackPanel>

								<StackPanel Grid.Column="1"
											Spacing="6">
									<TextBlock Text="Вид *"
											   FontWeight="SemiBold"
											   FontSize="12"/>
									<TextBox Text="{Binding NewPetSpecies}"
											 PlaceholderText="Собака"/>
								</StackPanel>

								<StackPanel Grid.Column="2"
											Spacing="6">
									<TextBlock Text="Порода"
											   FontWeight="SemiBold"
											   FontSize="12"/>
									<TextBox Text="{Binding NewPetBreed}"
											 PlaceholderText="Наприклад, Бігль"/>
								</StackPanel>

								<StackPanel Grid.Column="3"
											Spacing="6">
									<TextBlock Text="Народження"
											   FontWeight="SemiBold"
											   FontSize="12"/>
									<TextBox Text="{Binding NewPetBirthDate}"
											 PlaceholderText="ДД.ММ.РРРР"/>
								</StackPanel>

								<StackPanel Grid.Column="4"
											Spacing="6">
									<TextBlock Text="Вага (кг)"
											   FontWeight="SemiBold"
											   FontSize="12"/>
									<TextBox Text="{Binding NewPetWeight}"
											 PlaceholderText="Напр. 8,5"/>
								</StackPanel>

							</Grid>

							<TextBlock Text="* Обов'язкові поля"
									   FontSize="11"
									   Foreground="#718096"/>

							<StackPanel Orientation="Horizontal"
										HorizontalAlignment="Right"
										Spacing="10">

								<Button Content="Скасувати"
										Command="{Binding CancelAddPetCommand}"
										Padding="18,9"/>

								<Button Content="Зберегти тварину"
										Command="{Binding AddPetCommand}"
										Padding="18,9"
										Background="#0F9D78"
										Foreground="White"/>

							</StackPanel>

						</StackPanel>
					</Border>
					<!-- Форма додавання вимірювання -->
					<Border Background="White"
							CornerRadius="12"
							Padding="20"
							IsVisible="{Binding IsAddMeasurementFormVisible}">

						<StackPanel Spacing="14">

							<TextBlock Text="Додавання нового вимірювання"
									   FontSize="20"
									   FontWeight="Bold"
									   Foreground="#172B4D"/>

							<TextBlock Text="{Binding SelectedPet.Name,
                          StringFormat='Тварина: {0}'}"
									   Foreground="#64748B"
									   FontSize="14"/>

							<Grid ColumnDefinitions="*,*,*,*"
								  ColumnSpacing="12">

								<StackPanel Grid.Column="0"
											Spacing="6">
									<TextBlock Text="Тип показника *"
											   FontWeight="SemiBold"
											   FontSize="12"/>
									<TextBox Text="{Binding NewMeasurementType}"
											 PlaceholderText="Активність"/>
								</StackPanel>

								<StackPanel Grid.Column="1"
											Spacing="6">
									<TextBlock Text="Значення *"
											   FontWeight="SemiBold"
											   FontSize="12"/>
									<TextBox Text="{Binding NewMeasurementValue}"
											 PlaceholderText="Наприклад, 45"/>
								</StackPanel>

								<StackPanel Grid.Column="2"
											Spacing="6">
									<TextBlock Text="Одиниця *"
											   FontWeight="SemiBold"
											   FontSize="12"/>
									<TextBox Text="{Binding NewMeasurementUnit}"
											 PlaceholderText="хв, год, мл, кг"/>
								</StackPanel>

								<StackPanel Grid.Column="3"
											Spacing="6">
									<TextBlock Text="Дата *"
											   FontWeight="SemiBold"
											   FontSize="12"/>
									<TextBox Text="{Binding NewMeasurementDate}"
											 PlaceholderText="ДД.ММ.РРРР"/>
								</StackPanel>

							</Grid>

							<StackPanel Spacing="6">
								<TextBlock Text="Примітка"
										   FontWeight="SemiBold"
										   FontSize="12"/>
								<TextBox Text="{Binding NewMeasurementNotes}"
										 PlaceholderText="Додаткова інформація..."
										 AcceptsReturn="True"
										 MinHeight="65"
										 TextWrapping="Wrap"/>
							</StackPanel>

							<TextBlock Text="* Обов'язкові поля"
									   FontSize="11"
									   Foreground="#718096"/>

							<StackPanel Orientation="Horizontal"
										HorizontalAlignment="Right"
										Spacing="10">

								<Button Content="Скасувати"
										Command="{Binding CancelAddMeasurementCommand}"
										Padding="18,9"/>

								<Button Content="Зберегти вимірювання"
										Command="{Binding AddMeasurementCommand}"
										Padding="18,9"
										Background="#0F9D78"
										Foreground="White"/>

							</StackPanel>

						</StackPanel>
					</Border>

					<!-- Статистична картка -->
					<Border Background="White"
							CornerRadius="12"
							Padding="22"
							IsVisible="{Binding IsHomeSection}">

						<Grid ColumnDefinitions="*,*,*">

							<StackPanel Spacing="7">
								<TextBlock Text="Зареєстровано тварин"
                                           FontSize="13"
                                           Foreground="#718096"/>

								<TextBlock Text="{Binding PetCount}"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="#2563EB"/>
							</StackPanel>

							<StackPanel Grid.Column="1"
                                        Spacing="7">
								<TextBlock Text="Вимірювань вибраної тварини"
                                           FontSize="13"
                                           Foreground="#718096"/>

								<TextBlock Text="{Binding Measurements.Count}"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="#0F9D78"/>
							</StackPanel>

							<StackPanel Grid.Column="2"
                                        Spacing="7">
								<TextBlock Text="Стан системи"
                                           FontSize="13"
                                           Foreground="#718096"/>

								<TextBlock Text="Підключено"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#0F9D78"/>
							</StackPanel>

						</Grid>
					</Border>
					<!-- Панель експорту даних -->
					<Border Background="White"
							CornerRadius="12"
							Padding="18"
							IsVisible="{Binding IsHomeSection}">

						<StackPanel Spacing="12">
							<TextBlock Text="Експорт даних"
									   FontSize="18"
									   FontWeight="Bold"
									   Foreground="#172B4D"/>

							<TextBlock Text="Збереження інформації про всіх тварин та їхні вимірювання."
									   FontSize="13"
									   Foreground="#64748B"
									   TextWrapping="Wrap"/>

							<StackPanel Orientation="Horizontal"
										Spacing="10">

								<Button Content="Експорт у CSV"
										Click="ExportCsv_Click"
										Padding="16,10"
										Background="#0F9D78"
										Foreground="White"/>

								<Button Content="Експорт у Excel"
										Click="ExportExcel_Click"
										Padding="16,10"
										Background="#2563EB"
										Foreground="White"/>

							</StackPanel>
						</StackPanel>
					</Border>

					<!-- Список тварин і профіль -->
					<Grid ColumnDefinitions="300,*"
						  ColumnSpacing="20"
						  IsVisible="{Binding IsPetsSection}">

						<!-- Список -->
						<Border Grid.Column="0"
                                Background="White"
                                CornerRadius="12"
                                Padding="18">

							<StackPanel Spacing="14">

								<TextBlock Text="Мої тварини"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="#172B4D"/>
								<TextBox Text="{Binding SearchText}"
										 PlaceholderText="Пошук за ім'ям, видом або породою..."
										 FontSize="13"/>
								<ListBox ItemsSource="{Binding FilteredPets}"						
                                         SelectedItem="{Binding SelectedPet}"
                                         MinHeight="260"
                                         Background="Transparent"
                                         BorderThickness="0">

									<ListBox.ItemTemplate>
										<DataTemplate x:DataType="models:Pet">

											<Border Padding="10"
                                                    Margin="0,3"
                                                    CornerRadius="8">

												<StackPanel Spacing="4">
													<TextBlock Text="{Binding Name}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Foreground="#172B4D"/>

													<TextBlock Text="{Binding Species}"
                                                               FontSize="13"
                                                               Foreground="#64748B"/>

													<TextBlock Text="{Binding Breed}"
                                                               FontSize="12"
                                                               Foreground="#94A3B8"/>
												</StackPanel>

											</Border>

										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>

							</StackPanel>
						</Border>

						<!-- Профіль і вимірювання -->
						<Border Grid.Column="1"
                                Background="White"
                                CornerRadius="12"
                                Padding="20">

							<StackPanel Spacing="16">

								<TextBlock Text="Профіль тварини"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="#172B4D"/>
								<Border Background="#F8FAFC"
										CornerRadius="8"
										Padding="14"
										IsVisible="{Binding IsEditPetFormVisible}">

									<StackPanel Spacing="10">
										<TextBlock Text="Редагування профілю"
												   FontSize="17"
												   FontWeight="Bold"/>

										<TextBlock Text="Ім'я"/>
										<TextBox Text="{Binding EditPetName}"
												 PlaceholderText="Ім'я тварини"/>

										<TextBlock Text="Вид"/>
										<TextBox Text="{Binding EditPetSpecies}"
												 PlaceholderText="Вид тварини"/>

										<TextBlock Text="Порода"/>
										<TextBox Text="{Binding EditPetBreed}"
												 PlaceholderText="Порода"/>

										<TextBlock Text="Дата народження"/>
										<TextBox Text="{Binding EditPetBirthDate}"
												 PlaceholderText="ДД.ММ.РРРР"/>

										<TextBlock Text="Вага (кг)"/>
										<TextBox Text="{Binding EditPetWeight}"
												 PlaceholderText="Наприклад, 8,5"/>

										<StackPanel Orientation="Horizontal"
													HorizontalAlignment="Right"
													Spacing="8">

											<Button Content="Скасувати"
													Command="{Binding CancelEditPetCommand}"/>

											<Button Content="Зберегти"
													Command="{Binding UpdatePetCommand}"
													Background="#0F9D78"
													Foreground="White"/>
										</StackPanel>
									</StackPanel>
								</Border>
								<Border Background="#FEF2F2"
										BorderBrush="#FECACA"
										BorderThickness="1"
										CornerRadius="8"
										Padding="14"
										IsVisible="{Binding IsDeleteConfirmationVisible}">

									<StackPanel Spacing="10">
										<TextBlock Text="Підтвердження видалення"
												   FontSize="17"
												   FontWeight="Bold"
												   Foreground="#991B1B"/>

										<TextBlock Text="{Binding SelectedPet.Name,
                           StringFormat='Видалити тварину «{0}»?'}"
												   TextWrapping="Wrap"/>

										<TextBlock Text="Усі вимірювання цієї тварини також будуть видалені."
												   TextWrapping="Wrap"
												   Foreground="#991B1B"
												   FontSize="12"/>

										<StackPanel Orientation="Horizontal"
													HorizontalAlignment="Right"
													Spacing="8">

											<Button Content="Скасувати"
													Command="{Binding CancelDeletePetCommand}"/>

											<Button Content="Так, видалити"
													Command="{Binding ConfirmDeletePetCommand}"
													Background="#DC2626"
													Foreground="White"/>
										</StackPanel>
									</StackPanel>
								</Border>

								<StackPanel Spacing="6">
									<TextBlock Text="{Binding SelectedPet.Name, FallbackValue='Оберіть тварину'}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#2563EB"/>

									<TextBlock Text="{Binding SelectedPet.Species}"
                                               FontSize="14"
                                               Foreground="#475569"/>

									<TextBlock Text="{Binding SelectedPet.Breed}"
                                               FontSize="14"
                                               Foreground="#475569"/>
								</StackPanel>
								<TextBlock Text="{Binding SelectedPet.Id, StringFormat='ID: {0}'}"
										   FontSize="12"
										   Foreground="#64748B"/>

								<TextBlock Text="{Binding SelectedPet.BirthDate,
										   StringFormat='Дата народження: {0:dd.MM.yyyy}',
										   TargetNullValue='Дата народження: не вказана'}"
										   FontSize="13"
										   Foreground="#475569"/>

								<TextBlock Text="{Binding SelectedPet.CurrentWeightKg,
										   StringFormat='Вага: {0} кг',
										   TargetNullValue='Вага: не вказана'}"
										   FontSize="13"
										   Foreground="#475569"/>

								<StackPanel Orientation="Horizontal" Spacing="8">
									<Button Content="Редагувати"
											Command="{Binding ShowEditPetFormCommand}"
											Padding="12,8"/>

									<Button Content="Видалити"
											Command="{Binding ShowDeleteConfirmationCommand}"
											Padding="12,8"
											Background="#DC2626"
											Foreground="White"/>
								</StackPanel>

								<Border Height="1"
                                        Background="#E2E8F0"/>

								<TextBlock Text="Історія вимірювань"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#172B4D"/>

								<Grid ColumnDefinitions="*,*,*,*,Auto">

									<TextBlock Text="Дата"
                                               FontWeight="Bold"
                                               FontSize="12"/>

									<TextBlock Grid.Column="1"
                                               Text="Показник"
                                               FontWeight="Bold"
                                               FontSize="12"/>

									<TextBlock Grid.Column="2"
                                               Text="Значення"
                                               FontWeight="Bold"
                                               FontSize="12"/>

									<TextBlock Grid.Column="3"
                                               Text="Одиниця"
                                               FontWeight="Bold"
                                               FontSize="12"/>
									<TextBlock Grid.Column="4"
											   Text="Дії"
											   FontWeight="Bold"/>
								</Grid>

								<ItemsControl ItemsSource="{Binding Measurements}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="models:PetMeasurement">

											<Border BorderBrush="#E2E8F0"
                                                    BorderThickness="0,1,0,0"
                                                    Padding="0,10">

												<Grid ColumnDefinitions="*,*,*,*,Auto"
													  ColumnSpacing="8">

													<TextBlock
														Text="{Binding RecordedAt, StringFormat='{}{0:dd.MM.yyyy}'}"
														FontSize="12"
														VerticalAlignment="Center"/>

													<TextBlock Grid.Column="1"
															   Text="{Binding MeasurementType}"
															   FontSize="12"
															   VerticalAlignment="Center"/>

													<TextBlock Grid.Column="2"
															   Text="{Binding Value}"
															   FontSize="12"
															   FontWeight="SemiBold"
															   VerticalAlignment="Center"/>

													<TextBlock Grid.Column="3"
															   Text="{Binding Unit}"
															   FontSize="12"
															   VerticalAlignment="Center"/>

													<Button Grid.Column="4"
															Content="Видалити"
															Background="#FEE2E2"
															Foreground="#B91C1C"
															Padding="10,5"
															FontSize="11"
															Command="{Binding $parent[Window].DataContext.RequestDeleteMeasurementCommand}"
															CommandParameter="{Binding}"/>

												</Grid>
											</Border>

										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<!-- Підтвердження видалення вимірювання -->
								<Border Background="#FFF7ED"
										BorderBrush="#FDBA74"
										BorderThickness="1"
										CornerRadius="8"
										Padding="16"
										IsVisible="{Binding IsMeasurementDeleteConfirmationVisible}">

									<StackPanel Spacing="10">

										<TextBlock Text="Підтвердити видалення?"
												   FontSize="16"
												   FontWeight="Bold"
												   Foreground="#9A3412"/>

										<TextBlock
											Text="{Binding MeasurementToDelete.MeasurementType}"
											FontSize="13"
											Foreground="#475569"/>

										<TextBlock
											Text="Ви дійсно хочете видалити це вимірювання? Цю дію неможливо скасувати."
											TextWrapping="Wrap"
											FontSize="12"
											Foreground="#475569"/>

										<StackPanel Orientation="Horizontal"
													Spacing="10">

											<Button Content="Так, видалити"
													Background="#DC2626"
													Foreground="White"
													Padding="14,8"
													Command="{Binding ConfirmDeleteMeasurementCommand}"/>

											<Button Content="Скасувати"
													Padding="14,8"
													Command="{Binding CancelDeleteMeasurementCommand}"/>

										</StackPanel>

									</StackPanel>

								</Border>
							</StackPanel>
						</Border>

					</Grid>
					<!-- Окрема сторінка вимірювань -->
					<Border Background="White"
							CornerRadius="12"
							Padding="20"
							IsVisible="{Binding IsMeasurementsSection}">

						<StackPanel Spacing="14">

							<TextBlock Text="Історія вимірювань"
									   FontSize="21"
									   FontWeight="Bold"
									   Foreground="#172B4D"/>

							<TextBlock Text="{Binding SelectedPet.Name,
                          StringFormat='Вибрана тварина: {0}'}"
									   FontSize="14"
									   Foreground="#64748B"/>

							<ComboBox ItemsSource="{Binding Pets}"
									  SelectedItem="{Binding SelectedPet}"
									  HorizontalAlignment="Stretch">

								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="models:Pet">
										<TextBlock Text="{Binding Name}"/>
									</DataTemplate>
								</ComboBox.ItemTemplate>

							</ComboBox>

							<Grid ColumnDefinitions="*,*,*,*,Auto"
								  Margin="0,0,0,5">

								<TextBlock Text="Дата"
										   FontWeight="Bold"/>

								<TextBlock Grid.Column="1"
										   Text="Показник"
										   FontWeight="Bold"/>

								<TextBlock Grid.Column="2"
										   Text="Значення"
										   FontWeight="Bold"/>

								<TextBlock Grid.Column="3"
										   Text="Одиниця"
										   FontWeight="Bold"/>

								<TextBlock Grid.Column="4"
										   Text="Дії"
										   FontWeight="Bold"/>

							</Grid>

							<ItemsControl ItemsSource="{Binding Measurements}">

								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="models:PetMeasurement">

										<Border BorderBrush="#E2E8F0"
												BorderThickness="0,1,0,0"
												Padding="0,10">

											<Grid ColumnDefinitions="*,*,*,*,Auto"
												  ColumnSpacing="8">

												<TextBlock
													Text="{Binding RecordedAt, StringFormat='{}{0:dd.MM.yyyy}'}"
													FontSize="12"
													VerticalAlignment="Center"/>

												<TextBlock Grid.Column="1"
														   Text="{Binding MeasurementType}"
														   FontSize="12"
														   VerticalAlignment="Center"/>

												<TextBlock Grid.Column="2"
														   Text="{Binding Value}"
														   FontSize="12"
														   FontWeight="SemiBold"
														   VerticalAlignment="Center"/>

												<TextBlock Grid.Column="3"
														   Text="{Binding Unit}"
														   FontSize="12"
														   VerticalAlignment="Center"/>

												<Button Grid.Column="4"
														Content="Видалити"
														Background="#FEE2E2"
														Foreground="#B91C1C"
														Padding="10,5"
														FontSize="11"
														Command="{Binding $parent[Window].DataContext.RequestDeleteMeasurementCommand}"
														CommandParameter="{Binding}"/>

											</Grid>
										</Border>

									</DataTemplate>
								</ItemsControl.ItemTemplate>

							</ItemsControl>
							<!-- Підтвердження видалення вимірювання -->
							<Border Background="#FFF7ED"
									BorderBrush="#FDBA74"
									BorderThickness="1"
									CornerRadius="8"
									Padding="16"
									IsVisible="{Binding IsMeasurementDeleteConfirmationVisible}">

								<StackPanel Spacing="10">

									<TextBlock Text="Підтвердити видалення?"
											   FontSize="16"
											   FontWeight="Bold"
											   Foreground="#9A3412"/>

									<TextBlock
										Text="{Binding MeasurementToDelete.MeasurementType}"
										FontSize="13"
										Foreground="#475569"/>

									<TextBlock
										Text="Ви дійсно хочете видалити це вимірювання? Цю дію неможливо скасувати."
										TextWrapping="Wrap"
										FontSize="12"
										Foreground="#475569"/>

									<StackPanel Orientation="Horizontal"
												Spacing="10">

										<Button Content="Так, видалити"
												Background="#DC2626"
												Foreground="White"
												Padding="14,8"
												Command="{Binding ConfirmDeleteMeasurementCommand}"/>

										<Button Content="Скасувати"
												Padding="14,8"
												Command="{Binding CancelDeleteMeasurementCommand}"/>

									</StackPanel>

								</StackPanel>

							</Border>

						</StackPanel>
					</Border>


					<!-- Аналітична панель -->
					<Border Background="White"
							CornerRadius="12"
							Padding="20"
							IsVisible="{Binding IsAnalyticsSection}">

						<StackPanel Spacing="16">

							<TextBlock Text="Аналітика показників"
									   FontSize="21"
									   FontWeight="Bold"
									   Foreground="#172B4D"/>
							<!-- Режим аналітики -->
							<Border Background="#F1F5F9"
									CornerRadius="8"
									Padding="12">

								<StackPanel Spacing="8">

									<CheckBox Content="Усі тварини"
											  IsChecked="{Binding IsAllPetsAnalytics, Mode=TwoWay}"
											  FontSize="14"
											  FontWeight="SemiBold"
											  Foreground="#172B4D"/>

									<TextBlock Text="Увімкніть, щоб переглядати загальну статистику всіх тварин."
											   FontSize="12"
											   Foreground="#64748B"
											   TextWrapping="Wrap"/>

								</StackPanel>
							</Border>

							<StackPanel Spacing="6">
								<TextBlock Text="Період аналізу"
										   FontWeight="SemiBold"
										   FontSize="13"/>

								<ComboBox ItemsSource="{Binding AnalyticsPeriods}"
										  SelectedItem="{Binding SelectedAnalyticsPeriod}"
										  HorizontalAlignment="Stretch"/>
								<StackPanel Spacing="8"
											IsVisible="{Binding IsCustomAnalyticsPeriod}">

									<TextBlock Text="Власний діапазон дат"
											   FontWeight="SemiBold"
											   FontSize="13"/>

									<Grid ColumnDefinitions="*,*"
										  ColumnSpacing="12">

										<StackPanel Spacing="5">
											<TextBlock Text="Дата від"
													   FontSize="12"
													   FontWeight="SemiBold"/>

											<TextBox Text="{Binding AnalyticsStartDate}"
													PlaceholderText="ДД.ММ.РРРР"/>
										</StackPanel>

										<StackPanel Grid.Column="1"
													Spacing="5">

											<TextBlock Text="Дата до"
													   FontSize="12"
													   FontWeight="SemiBold"/>

											<TextBox Text="{Binding AnalyticsEndDate}"
													 PlaceholderText="ДД.ММ.РРРР"/>
										</StackPanel>

									</Grid>

									<TextBlock Text="Вкажіть дати у форматі ДД.ММ.РРРР."
											   FontSize="11"
											   Foreground="#718096"/>

								</StackPanel>

								<TextBlock Text="Оберіть показник"
										   FontWeight="SemiBold"
										   FontSize="13"/>

								<ComboBox ItemsSource="{Binding MeasurementTypes}"
										  SelectedItem="{Binding SelectedAnalyticsType}"
										  PlaceholderText="Оберіть показник"
										  HorizontalAlignment="Stretch"/>
							</StackPanel>

							<!-- Статистика -->
							<Grid ColumnDefinitions="*,*,*"
								  ColumnSpacing="12">

								<Border Grid.Column="0"
										Background="#EFF6FF"
										CornerRadius="8"
										Padding="14">
									<StackPanel Spacing="5">
										<TextBlock Text="Середнє значення"
												   Foreground="#64748B"
												   FontSize="12"/>
										<TextBlock Text="{Binding AverageValue}"
												   FontSize="24"
												   FontWeight="Bold"
												   Foreground="#2563EB"/>
									</StackPanel>
								</Border>

								<Border Grid.Column="1"
										Background="#F0FDF4"
										CornerRadius="8"
										Padding="14">
									<StackPanel Spacing="5">
										<TextBlock Text="Мінімум"
												   Foreground="#64748B"
												   FontSize="12"/>
										<TextBlock Text="{Binding MinimumValue}"
												   FontSize="24"
												   FontWeight="Bold"
												   Foreground="#0F9D78"/>
									</StackPanel>
								</Border>

								<Border Grid.Column="2"
										Background="#FFF7ED"
										CornerRadius="8"
										Padding="14">
									<StackPanel Spacing="5">
										<TextBlock Text="Максимум"
												   Foreground="#64748B"
												   FontSize="12"/>
										<TextBlock Text="{Binding MaximumValue}"
												   FontSize="24"
												   FontWeight="Bold"
												   Foreground="#EA580C"/>
									</StackPanel>
								</Border>

							</Grid>

							<!-- Графік -->
							<TextBlock Text="Динаміка показника"
									   FontSize="17"
									   FontWeight="Bold"
									   Foreground="#172B4D"/>

							<ItemsControl ItemsSource="{Binding ChartBars}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Grid ColumnDefinitions="110,65,*,65"
											  ColumnSpacing="10"
											  Margin="0,5">
											<TextBlock Text="{Binding PetName}"
													   VerticalAlignment="Center"
													   FontSize="12"
													   Foreground="#475569"
													   TextTrimming="CharacterEllipsis"/>

											<TextBlock Grid.Column="1"
													   Text="{Binding DateLabel}"
													   VerticalAlignment="Center"
													   FontSize="12"
													   Foreground="#64748B"/>

											<ProgressBar Grid.Column="2"
														 Value="{Binding Percentage}"
														 Maximum="100"
														 Height="12"
														 VerticalAlignment="Center"/>

											<TextBlock Grid.Column="3"
													   Text="{Binding ValueLabel}"
													   VerticalAlignment="Center"
													   HorizontalAlignment="Right"
													   FontSize="12"
													   FontWeight="SemiBold"
													   Foreground="#172B4D"/>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<Border Background="#F1F5F9"
									CornerRadius="10"
									Padding="14"
									Margin="0,12,0,0">
								<StackPanel Spacing="12">
									<TextBlock Text="Порівняння тварин"
											   FontSize="16"
											   FontWeight="SemiBold"
											   Foreground="#172B4D"/>

									<TextBlock Text="Оберіть тварин для порівняння:"
											   FontSize="12"
											   Foreground="#64748B"
											   Margin="0,4,0,0"/>

									<ItemsControl ItemsSource="{Binding PetComparisonSelections}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<CheckBox Content="{Binding PetName}"
														  IsChecked="{Binding IsSelected, Mode=TwoWay}"
														  FontSize="13"
														  Foreground="#334155"
														  Margin="0,3"/>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>


									<TextBlock Text="Середнє значення показника за вибраний період"
											   FontSize="12"
											   Foreground="#64748B"
											   TextWrapping="Wrap"/>

									<ItemsControl ItemsSource="{Binding PetComparisons}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<StackPanel Spacing="5" Margin="0,5">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Text="{Binding PetName}"
																   FontSize="13"
																   FontWeight="SemiBold"
																   Foreground="#334155"/>

														<TextBlock Grid.Column="1"
																   Text="{Binding AverageLabel}"
																   FontSize="13"
																   FontWeight="SemiBold"
																   Foreground="#172B4D"/>
													</Grid>

													<ProgressBar Value="{Binding Percentage}"
																 Maximum="100"
																 Height="12"/>

													<TextBlock
														Text="{Binding MeasurementCount, StringFormat='Вимірювань: {0}'}"
														FontSize="11"
														Foreground="#64748B"/>
												</StackPanel>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>

									
								</StackPanel>
							</Border>


							<TextBlock Text="{Binding AnalyticsUnit,
									   StringFormat='Одиниця вимірювання: {0}'}"
									   FontSize="12"
									   Foreground="#64748B"/>

							<!-- Результат аналізу -->
							<Border Background="#EFF6FF"
									CornerRadius="8"
									Padding="14">

								<StackPanel Spacing="6">
									<TextBlock Text="Результат аналізу"
											   FontWeight="Bold"
											   Foreground="#172B4D"/>

									<TextBlock Text="{Binding AnalysisMessage}"
											   TextWrapping="Wrap"
											   Foreground="#244B80"/>
								</StackPanel>

							</Border>

						</StackPanel>
					</Border>

					<!-- Повідомлення -->
					<Border Background="#E8F0FE"
                            CornerRadius="8"
                            Padding="14">

						<TextBlock Text="{Binding StatusMessage}"
                                   FontSize="13"
                                   Foreground="#244B80"
                                   TextWrapping="Wrap"/>

					</Border>

				</StackPanel>
			</ScrollViewer>
		</Grid>
	</Grid>
</Window>
